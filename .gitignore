# Run artifacts (not tracked; see README 复现与数据政策)
results/
temp/
trained_models/
tensorboard_log/
datasets/

# Local-only test code and notes
local_test/

# final_deliverables/ is intentionally NOT ignored:
# it is committed once at final delivery (one-shot, no incremental tracking).

# Poetry is not used for environment management (requirements-lock.txt is authoritative)
poetry.lock

# Upstream sample model weights (training artifacts, not code)
*.pth

# Exception: keep upstream documentation / README images tracked.
# The broad *.png rule above targets run-artifact screenshots in the root;
# docs/source/image/ and figs/ are part of the upstream docs and must be kept.
!docs/source/image/*.png
!docs/source/image/*.PNG
!figs/*.png
!figs/*.PNG
/.github/copilot-instructions.md
